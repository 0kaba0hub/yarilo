# Copy to .env and adjust. All values have sane defaults in docker-compose.yml.

# Image
YARILO_IMAGE=ghcr.io/0kaba0hub/yarilo
YARILO_TAG=latest
LOG_LEVEL=info

# Host ports (left side = host, container side is fixed)
IMAP_PORT=143
IMAPS_PORT=993
POP3_PORT=110
POP3S_PORT=995
SUBMISSION_PORT=587
SUBMISSIONS_PORT=465
LMTP_PORT=24
SIEVE_PORT=4190
TELEMETRY_PORT=8080

# LMTP and ManageSieve are unauthenticated / plaintext in single mode — bound to
# loopback by default. Set to 0.0.0.0 only if you firewall the host and know why.
LMTP_BIND=127.0.0.1
SIEVE_BIND=127.0.0.1

# --- full profile only (MariaDB) ---
DB_NAME=yarilo
DB_USER=yarilo
DB_PASSWORD=yarilo-secret
DB_ROOT_PASSWORD=root-secret

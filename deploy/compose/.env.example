# Copy to .env and adjust. All values have sane defaults in docker-compose.yml.

# Image
YARILO_TAG=latest
LOG_LEVEL=info

# Client-facing host ports (host:container is fixed inside the compose file)
IMAP_PORT=143
IMAPS_PORT=993
POP3_PORT=110
POP3S_PORT=995
SUBMISSION_PORT=587
SUBMISSIONS_PORT=465
SIEVE_PORT=4190
# JMAP: the login service is commented out in docker-compose.yml until the backend lands.
JMAP_PORT=8443

# Unauthenticated LMTP and the MTA-integration sockets (SASL auth, quota policy)
# are bound to loopback by default. Point them at your MTA host only, firewalled.
LMTP_PORT=24
LMTP_BIND=127.0.0.1
SASL_PORT=12325
SASL_BIND=127.0.0.1
QUOTA_STATUS_PORT=12340
QUOTA_STATUS_BIND=127.0.0.1

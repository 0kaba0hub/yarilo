# Build outputs — root-level dev builds. `go build ./app/<name>/` (no -o) drops
# the compiled binary in the repo root; ignore every such artifact by pattern so
# no new binary can slip in (imap/pop3/submission/managesieve-login, fts, etc.).
/yarilo
/yarilo-*
/smoketest
/yarctl
/fts-bench
# Binaries built inside their app dir (older habit)
app/yarilo/yarilo
app/yarilo-migrate/yarilo-migrate
app/smoketest/smoketest
app/smoketest-e2e/smoketest-e2e

# macOS
.DS_Store

# Local-only docs (internal design/planning notes, not shipped)
docs_internal/
